<div class="py-6">
  <div class="mb-6">
    <p class="text-xs font-display font-bold text-brand uppercase tracking-wider mb-1">Back office</p>
    <h1 class="text-3xl font-display font-black text-ink">Usuarios</h1>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-surface border-2 border-ink rounded-xl p-5 shadow-brutal">
      <p class="text-xs font-display font-bold text-ink/60 uppercase tracking-wider">Total</p>
      <p class="text-4xl font-display font-black text-ink"><%= @total_count %></p>
    </div>
    <div class="bg-surface border-2 border-ink rounded-xl p-5 shadow-brutal">
      <p class="text-xs font-display font-bold text-ink/60 uppercase tracking-wider">Activos</p>
      <p class="text-4xl font-display font-black text-ink"><%= @active_count %></p>
      <p class="text-xs text-ink/60 mt-1">Con sesión en los últimos <%= User::ACTIVE_WINDOW.in_days.to_i %> días</p>
    </div>
    <div class="bg-surface border-2 border-ink rounded-xl p-5 shadow-brutal">
      <p class="text-xs font-display font-bold text-ink/60 uppercase tracking-wider">Inactivos</p>
      <p class="text-4xl font-display font-black text-ink"><%= @total_count - @active_count %></p>
    </div>
  </div>

  <div class="bg-surface border-2 border-ink rounded-xl shadow-brutal overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b-2 border-ink text-left font-display font-bold text-ink">
          <th class="px-4 py-3">Usuario</th>
          <th class="px-4 py-3">Email</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3">Última sesión</th>
          <th class="px-4 py-3">Registro</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="border-b border-ink/10 last:border-0">
            <td class="px-4 py-3 font-bold text-ink"><%= user.full_name.strip.presence || "—" %></td>
            <td class="px-4 py-3 text-ink/80"><%= user.email %></td>
            <td class="px-4 py-3">
              <% if user.active? %>
                <span class="inline-flex items-center gap-1.5 font-bold text-green-700"><span class="w-2 h-2 rounded-full bg-green-500"></span>Activo</span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 font-bold text-ink/50"><span class="w-2 h-2 rounded-full bg-ink/30"></span>Inactivo</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-ink/80">
              <%= user.current_sign_in_at ? "hace #{time_ago_in_words(user.current_sign_in_at)}" : "Sin datos" %>
            </td>
            <td class="px-4 py-3 text-ink/80"><%= l user.created_at.to_date %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
