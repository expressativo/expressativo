<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Documento" %></title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        color: #111827;
        line-height: 1.6;
        padding: 0 1.5rem;
      }
      h1.doc-title {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
      }
      .doc-meta {
        font-size: 0.8rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e5e7eb;
      }
      .doc-body h1 { font-size: 1.5rem; margin: 1.2em 0 0.5em; }
      .doc-body h2 { font-size: 1.25rem; margin: 1.2em 0 0.5em; }
      .doc-body h3 { font-size: 1.1rem; margin: 1.2em 0 0.5em; }
      .doc-body p { margin: 0 0 1em; }
      .doc-body ul, .doc-body ol { margin: 0 0 1em; padding-left: 1.5em; }
      .doc-body blockquote {
        border-left: 3px solid #d1d5db;
        margin: 0 0 1em;
        padding-left: 1em;
        color: #4b5563;
      }
      .doc-body img, .doc-body .attachment img {
        max-width: 100%;
        border-radius: 0.25rem;
      }
      .doc-body figure { margin: 1em 0; }
      .doc-body figcaption { font-size: 0.75rem; color: #6b7280; }
      .doc-body table { border-collapse: collapse; width: 100%; margin-bottom: 1em; }
      .doc-body table td, .doc-body table th {
        border: 1px solid #e5e7eb;
        padding: 0.4em 0.6em;
      }
      .doc-body pre {
        background: #f3f4f6;
        padding: 0.75em;
        border-radius: 0.25rem;
        overflow-x: auto;
      }
      a { color: #4f46e5; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
