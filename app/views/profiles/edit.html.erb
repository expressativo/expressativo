<% content_for :title, "Editar Perfil" %>

<div class="max-w-3xl mx-auto">
  <div class="bg-surface border-2 border-ink shadow-brutal-lg rounded-xl px-8 py-8">

    <%= form_with model: @user, url: profile_path, method: :patch, data: { controller: "avatar-preview" }, class: "space-y-6", multipart: true do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-danger-light border border-danger/40 rounded-lg p-4">
          <h3 class="text-danger font-semibold mb-2">
            <%= pluralize(@user.errors.count, "error") %> impidieron guardar los cambios:
          </h3>
          <ul class="list-disc list-inside text-danger">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Avatar -->
      <div class="space-y-4">
        <label class="block text-sm font-semibold text-ink/80 uppercase tracking-wide">
          Foto de Perfil
        </label>
        
        <div class="flex items-center gap-6">
          <!-- Preview del avatar -->
          <div data-avatar-preview-target="preview">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "w-24 h-24 rounded-full object-cover border-4 border-ink", data: { avatar_preview_target: "image" } %>
            <% else %>
              <div class="w-24 h-24 rounded-full bg-brand border-2 border-ink flex items-center justify-center" data-avatar-preview-target="placeholder">
                <span class="text-white text-2xl font-bold">
                  <%= @user.first_name&.first&.upcase %><%= @user.last_name&.first&.upcase %>
                </span>
              </div>
            <% end %>
          </div>

          <!-- Input de archivo -->
          <div class="flex-1">
            <%= f.file_field :avatar, 
              accept: "image/png,image/jpeg",
              class: "block w-full text-sm text-ink/50 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-2 file:border-ink file:text-sm file:font-bold file:bg-brand-light file:text-brand-dark hover:file:bg-accent cursor-pointer",
              data: { action: "change->avatar-preview#preview" } %>
            <p class="mt-2 text-xs text-ink/50">PNG o JPG (máx. 5MB)</p>
          </div>
        </div>
      </div>

      <hr class="border-ink">

      <!-- Información Personal -->
      <div class="space-y-4">
        <h2 class="text-xl font-semibold text-ink">Información Personal</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Nombre -->
          <div>
            <%= f.label :first_name, "Nombre", class: "label mb-2" %>
            <%= f.text_field :first_name, 
              class: "input",
              placeholder: "Tu nombre" %>
          </div>

          <!-- Apellido -->
          <div>
            <%= f.label :last_name, "Apellido", class: "label mb-2" %>
            <%= f.text_field :last_name, 
              class: "input",
              placeholder: "Tu apellido" %>
          </div>
        </div>

        <!-- Email -->
        <div>
          <%= f.label :email, "Correo Electrónico", class: "label mb-2" %>
          <%= f.email_field :email, 
            class: "input",
            placeholder: "tu@email.com" %>
        </div>
      </div>

      <hr class="border-ink">

      <!-- Cambiar Contraseña -->
      <div class="space-y-4">
        <h2 class="text-xl font-semibold text-ink">Cambiar Contraseña</h2>
        <p class="text-sm text-ink/70">Deja estos campos en blanco si no deseas cambiar tu contraseña</p>
        
        <!-- Nueva Contraseña -->
        <div>
          <%= f.label :password, "Nueva Contraseña", class: "label mb-2" %>
          <%= f.password_field :password, 
            autocomplete: "new-password",
            class: "input",
            placeholder: "Mínimo 6 caracteres" %>
        </div>

        <!-- Confirmar Contraseña -->
        <div>
          <%= f.label :password_confirmation, "Confirmar Nueva Contraseña", class: "label mb-2" %>
          <%= f.password_field :password_confirmation, 
            autocomplete: "new-password",
            class: "input",
            placeholder: "Repite la contraseña" %>
        </div>
      </div>

      <!-- Botones de acción -->
      <div class="flex items-center justify-between pt-6 border-t-2 border-ink">
        <%= link_to "Cancelar", profile_path, class: "button-outline" %>
        <%= f.submit "Guardar Cambios", class: "button" %>
      </div>
    <% end %>
  </div>
</div>
