<%
  active ||= :summary
  items = [
    { id: :summary,    label: "Resumen",    href: project_path(project) },
    { id: :boards,     label: "Tableros",   href: project_boards_path(project) },
    { id: :todos,      label: "To-dos",     href: project_todos_path(project) },
    { id: :documents,  label: "Documentos", href: project_documents_path(project) }
  ]
  items << { id: :calendar, label: "Calendario", href: project_calendar_path(project) } if project.has_calendar
  items << { id: :announcements, label: "Anuncios",  href: project_announcements_path(project) }
  items << { id: :chat,          label: "Chat",      href: project_channels_path(project) }
  items << { id: :members,       label: "Miembros",  href: project_members_path(project) }
%>
<nav class="bg-surface border-2 border-ink rounded-xl px-2 overflow-x-auto shadow-brutal">
  <ul class="flex items-center gap-1 min-w-max">
    <% items.each do |item| %>
      <% is_active = item[:id] == active %>
      <li>
        <%= link_to item[:label], item[:href],
              class: "inline-flex items-center px-3 py-2.5 text-sm font-bold border-b-2 transition-colors whitespace-nowrap #{is_active ? 'text-brand-dark border-brand' : 'text-ink/60 border-transparent hover:text-ink hover:border-ink/30'}" %>
      </li>
    <% end %>
  </ul>
</nav>
