<%
  today = Date.today
  month_tasks = Task.joins(:todo)
                     .where(todos: { project_id: @project.id })
                     .where(due_date: today.beginning_of_month.beginning_of_day..today.end_of_month.end_of_day)
                     .includes(:todo)
                     .order(:due_date)
%>
<section class="bg-surface border-2 border-ink rounded-xl">
  <header class="flex items-center justify-between px-5 py-4 border-b-2 border-ink/10">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <h2 class="text-base font-semibold text-ink">Calendario</h2>
      <span class="text-xs font-medium text-ink/50 bg-accent/30 px-2 py-0.5 rounded-full"><%= month_tasks.count %></span>
    </div>
    <%= link_to "Ver calendario", project_calendar_path(@project), class: "text-xs font-medium text-brand hover:text-brand-dark" %>
  </header>

  <% if month_tasks.any? %>
    <ul class="divide-y-2 divide-ink/10">
      <% month_tasks.limit(4).each do |task| %>
        <li class="px-5 py-3 flex items-start gap-3">
          <div class="flex-shrink-0 w-10 text-center">
            <div class="text-xs uppercase text-ink/50 font-medium leading-none mt-0.5"><%= task.due_date.strftime('%b') %></div>
            <div class="text-lg font-bold text-ink leading-tight"><%= task.due_date.strftime('%d') %></div>
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-ink truncate <%= 'line-through text-ink/40' if task.completed? %>"><%= task.title %></div>
            <% if task.completed? %>
              <div class="inline-flex items-center gap-1 text-xs text-success mt-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Completada
              </div>
            <% else %>
              <div class="text-xs text-ink/50 mt-0.5 truncate"><%= task.todo.name %></div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <% if month_tasks.count > 4 %>
      <div class="px-5 py-3 border-t-2 border-ink/10 text-center">
        <%= link_to "+ #{month_tasks.count - 4} más este mes", project_calendar_path(@project), class: "text-xs font-medium text-brand hover:text-brand-dark" %>
      </div>
    <% end %>
  <% else %>
    <div class="px-5 py-10 text-center">
      <svg class="w-10 h-10 mx-auto text-ink/30 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <p class="text-sm text-ink/50 mb-2">Sin tareas con fecha este mes.</p>
      <%= link_to "Ver calendario", project_calendar_path(@project), class: "inline-block text-xs font-medium text-brand hover:text-brand-dark" %>
    </div>
  <% end %>
</section>
