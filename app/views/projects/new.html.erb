<div class="max-w-3xl mx-auto py-4">
  <nav class="flex items-center text-sm text-ink/50 mb-3 flex-wrap" aria-label="Breadcrumb">
    <%= link_to "Proyectos", projects_path, class: "hover:text-brand transition-colors" %>
    <svg class="w-4 h-4 mx-1 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-ink/80 font-medium">Nuevo proyecto</span>
  </nav>

  <section class="bg-surface border-2 border-ink rounded-xl overflow-hidden">
    <header class="px-6 py-5 border-b-2 border-ink">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-brand border-2 border-ink flex items-center justify-center text-white flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-semibold text-ink">Nuevo proyecto</h1>
          <p class="text-sm text-ink/50">Crea un espacio para organizar tareas y colaborar con tu equipo.</p>
        </div>
      </div>
    </header>

    <%= render 'projects/form', project: @project %>
  </section>
</div>
