<div class="py-6">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
    <div>
      <p class="text-xs font-display font-bold text-brand uppercase tracking-wider mb-1">Tivo</p>
      <h1 class="text-3xl font-display font-black text-ink">Proyectos</h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to archived_projects_path, class: "button-outline" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
        </svg>
        Archivados
      <% end %>
      <%= link_to new_project_path, class: "button" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Crear proyecto
      <% end %>
    </div>
  </div>

  <% if @projects.any? %>
    <%= render 'projects/list', projects: @projects %>
  <% else %>
    <div class="bg-surface border-2 border-ink rounded-xl p-12 text-center shadow-brutal">
      <figure class="h-[220px] mx-auto mb-6">
        <img src="undraw_no-data_ig65.svg" alt="No hay datos" class="h-full mx-auto">
      </figure>
      <h3 class="text-lg font-display font-bold text-ink mb-1">Registra tu primer proyecto</h3>
      <p class="text-sm text-ink/60 mb-5">Crea un proyecto para empezar a organizar tu trabajo.</p>
      <%= link_to "+ Crear proyecto", new_project_path, class: "button" %>
    </div>
  <% end %>
</div>
