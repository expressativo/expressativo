<div class="max-w-3xl mx-auto py-4">
  <nav class="flex items-center text-sm text-ink/50 mb-3 flex-wrap" aria-label="Breadcrumb">
    <%= link_to "Proyectos", projects_path, class: "hover:text-brand transition-colors" %>
    <svg class="w-4 h-4 mx-1 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <%= link_to @project.title, project_path(@project), class: "hover:text-brand transition-colors truncate" %>
    <svg class="w-4 h-4 mx-1 text-ink/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-ink/80 font-medium">Editar</span>
  </nav>

  <section class="bg-surface border-2 border-ink rounded-xl overflow-hidden">
    <header class="px-6 py-5 border-b-2 border-ink">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-brand border-2 border-ink flex items-center justify-center text-white font-display font-bold text-sm flex-shrink-0">
          <%= @project.title.to_s.first(2).upcase %>
        </div>
        <div class="min-w-0">
          <h1 class="text-xl font-semibold text-ink truncate">Editar proyecto</h1>
          <p class="text-sm text-ink/50 truncate">Actualiza los datos de <%= @project.title %>.</p>
        </div>
      </div>
    </header>

    <%= render 'projects/form', project: @project %>
  </section>
</div>
