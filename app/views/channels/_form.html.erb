<%= form_with model: channel, url: channel.persisted? ? project_channel_path(project, channel) : project_channels_path(project), class: "space-y-4" do |f| %>
  <% if channel.errors.any? %>
    <div class="errors">
      <%= channel.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label mb-1" %>
    <%= f.text_field :name, class: "input", placeholder: "general" %>
  </div>

  <div>
    <%= f.label :description, class: "label mb-1" %>
    <%= f.text_area :description, rows: 2, class: "textarea", placeholder: "¿Para qué es este canal?" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "button" %>
    <%= link_to "Cancelar", project_channels_path(project), class: "text-sm font-semibold text-ink/60 hover:underline" %>
  </div>
<% end %>
