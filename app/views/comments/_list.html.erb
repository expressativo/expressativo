<%# Comments list. Requires locals: commentable, comments (optional, defaults to commentable.comments) %>
<% commentable ||= @commentable %>
<% comments ||= @comments || commentable.comments.includes(:user).order(created_at: :desc) %>
<div class="mt-6" id="comments">
  <% if comments.any? %>
    <h3 class="text-lg font-medium text-gray-900">Comentarios</h3>
  <% end %>
  <div class="mt-2 space-y-4">
    <% comments.each do |comment| %>
      <%= render "comments/comment", comment: comment, commentable: commentable %>
    <% end %>
  </div>
</div>
