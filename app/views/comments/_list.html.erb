<%# Comments list. Requires locals: commentable, comments (optional, defaults to commentable.comments), show_heading (optional, default true) %>
<% commentable ||= @commentable %>
<% show_heading = local_assigns.fetch(:show_heading, true) %>
<% comments ||= @comments || commentable.comments.includes(:user).order(created_at: :desc) %>
<div class="<%= 'mt-6' if show_heading %>" id="comments">
  <% if show_heading && comments.any? %>
    <h3 class="text-lg font-medium text-ink">Comentarios</h3>
  <% end %>
  <div class="<%= 'mt-2' if show_heading %> space-y-4">
    <% comments.each do |comment| %>
      <%= render "comments/comment", comment: comment, commentable: commentable %>
    <% end %>
  </div>
</div>
