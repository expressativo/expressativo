<%# New comment form with mention support via lexxy-prompt. Requires locals: commentable %>
<% commentable ||= @commentable %>
<div data-controller="show-comment-section">
  <%= form_for :comment, url: comment_create_path(commentable), class: "hidden", method: :post do |f| %>
    <div class="comment" data-controller="mention-form">
      <div class="input-wrapper">
        <%= f.label :content, "Tu comentario (usa @ para mencionar)", class: "label" %>
        <%= f.rich_text_area :content, placeholder: "Escribe tu comentario... Usa @ para mencionar" do %>
          <lexxy-prompt trigger="@" src="<%= comment_search_members_path(commentable) %>" remote-filtering insert-editable-text empty-results="Sin coincidencias"></lexxy-prompt>
        <% end %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "Agregar Comentario", class: "button", data: {
          turbo_submits_with: "Comentando..."
        } %>
        <button type="button" class="button-outline" data-action="click->show-comment-section#toggle">Cancelar</button>
      </div>
    </div>
  <% end %>

  <button id="toggle-add-comment" type="button"
          class="w-full text-left px-3 py-2.5 text-sm text-ink/50 bg-surface border-2 border-ink/20 rounded-lg hover:border-ink cursor-text transition-colors"
          data-action="click->show-comment-section#toggle">
    Escribe un comentario… usa @ para mencionar
  </button>
</div>
