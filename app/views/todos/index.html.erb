<%= render layout: 'projects/layout', locals: { project: @project, active: :todos } do %>
  <section class="bg-surface border-2 border-ink rounded-xl overflow-hidden">
    <header class="px-6 py-4 border-b-2 border-ink flex items-center justify-between gap-4 flex-wrap">
      <div class="min-w-0">
        <h2 class="text-lg font-semibold text-ink">Listas de tareas</h2>
        <p class="text-sm text-ink/50">Organiza tu trabajo agrupando tareas en listas.</p>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <% if @todos.any? %>
          <div class="inline-flex rounded-md border-2 border-ink overflow-hidden" role="group">
            <%= link_to project_todos_path(@project, view: 'list'),
                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-bold transition #{@view_type == 'list' ? 'bg-brand-light text-brand-dark' : 'bg-surface text-ink/80 hover:bg-accent/20'}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              Lista
            <% end %>
            <%= link_to project_todos_path(@project, view: 'grid'),
                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-bold border-l-2 border-ink transition #{@view_type == 'grid' ? 'bg-brand-light text-brand-dark' : 'bg-surface text-ink/80 hover:bg-accent/20'}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              Cuadrícula
            <% end %>
          </div>

          <%= link_to new_project_todo_path, class: "button text-sm px-3 py-1.5" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nueva lista
          <% end %>
        <% end %>
      </div>
    </header>

    <% if @todos.any? %>
      <%= render 'todos/todo_list' %>
    <% else %>
      <div class="px-6 py-16 text-center">
        <div class="w-20 h-20 mx-auto mb-5 rounded-xl bg-brand-light border-2 border-ink flex items-center justify-center text-brand">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <h3 class="text-lg font-display font-bold text-ink mb-1">Crea tu primera lista</h3>
        <p class="text-sm text-ink/50 mb-5 max-w-sm mx-auto">
          Las listas te ayudan a agrupar tareas relacionadas y ver el progreso de un vistazo.
        </p>
        <%= link_to new_project_todo_path, class: "button" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Crear lista
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
