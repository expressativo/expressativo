<%= form_with model: [project, todo], local: true, class: "p-6" do |form| %>
  <% if todo.errors.any? %>
    <div class="bg-danger-light border border-danger/40 rounded-md p-4 mb-5 text-sm text-danger">
      <p class="font-medium mb-1">
        Hay <%= pluralize(todo.errors.count, "error") %> que corregir:
      </p>
      <ul class="list-disc list-inside space-y-0.5">
        <% todo.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4 space-y-1.5">
    <%= form.label :name, "Título", class: "block text-ink/80 text-sm font-medium" %>
    <%= form.text_field :name,
          class: "input",
          placeholder: "Ej. Backlog, Sprint actual, Ideas…",
          autofocus: true %>
    <p class="text-ink/50 text-xs">Un nombre corto que describa el contenido de la lista.</p>
  </div>

  <div class="flex items-center justify-end gap-2 pt-5 mt-2 border-t-2 border-ink/10">
    <%= link_to "Cancelar", project_todos_path(project),
          class: "inline-flex items-center px-4 py-2 button-outline" %>
    <%= form.submit todo.persisted? ? "Guardar cambios" : "Crear lista",
          class: "button",
          data: { turbo_submits_with: "Guardando..." } %>
  </div>
<% end %>
