<%= form_with model: [@project, template], class: "space-y-4" do |f| %>
  <div>
    <%= f.label :name, "Nombre del template", class: "block text-xs font-medium text-ink/80 mb-1" %>
    <%= f.text_field :name,
        placeholder: "ej: Bug report, Feature request",
        required: true,
        class: "w-full px-3 py-2 text-sm bg-paper border-2 border-ink rounded-lg focus:outline-none focus:ring-2 focus:ring-0" %>
    <p class="mt-1 text-[11px] text-ink/40">Nombre que se mostrará al crear una tarea.</p>
  </div>

  <div>
    <%= f.label :title, class: "block text-xs font-medium text-ink/80 mb-1" do %>
      Título pre-llenado <span class="text-ink/40 font-normal">(opcional)</span>
    <% end %>
    <%= f.text_field :title,
        placeholder: "ej: [BUG] ",
        class: "w-full px-3 py-2 text-sm bg-paper border-2 border-ink rounded-lg focus:outline-none focus:ring-2 focus:ring-0" %>
  </div>

  <div>
    <%= f.label :notes, class: "block text-xs font-medium text-ink/80 mb-1" do %>
      Notas pre-llenadas <span class="text-ink/40 font-normal">(opcional)</span>
    <% end %>
    <%= f.rich_text_area :notes,
        placeholder: "Contenido inicial de la tarea...",
        class: "prose prose-sm max-w-none" %>
  </div>

  <%= f.submit template.persisted? ? "Guardar cambios" : "Crear template",
      class: "button w-full" %>
<% end %>
