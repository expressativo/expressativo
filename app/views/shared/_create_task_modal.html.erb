<%# locals: (modal_title: "Crear tarea", show_selection_menu: false) %>

<% if show_selection_menu %>
  <div
    class="dropdown-menu hidden fixed z-50 py-1 min-w-max"
    data-create-task-modal-target="menu"
  >
    <button
      type="button"
      class="flex items-center gap-2 px-3 py-2 text-sm font-semibold text-ink hover:bg-accent/40 w-full text-left transition-colors"
      data-action="click->create-task-modal#openFromSelection"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12h14"/>
      </svg>
      Crear tarea
    </button>
  </div>
<% end %>

<div
  class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"
  data-create-task-modal-target="modal"
  data-action="click->create-task-modal#backdropClick"
>
  <div class="bg-surface border-2 border-ink rounded-xl p-6 max-w-md w-full mx-4 shadow-brutal-lg">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-base font-display font-bold text-ink"><%= modal_title %></h3>
      <button
        type="button"
        class="text-ink/50 hover:text-ink transition-colors"
        data-action="click->create-task-modal#closeModal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <form data-action="submit->create-task-modal#createTask">
      <div class="hidden mb-4" data-create-task-modal-target="templatePicker">
        <p class="label mb-2">¿Cómo quieres crear la tarea?</p>
        <div class="flex flex-wrap gap-1.5" data-create-task-modal-target="templateList"></div>
      </div>
      <div class="mb-4">
        <label class="label mb-1">Título de la tarea</label>
        <input
          type="text"
          class="input"
          data-create-task-modal-target="taskTitle"
          placeholder="Título de la tarea"
          required
        >
      </div>
      <div class="mb-4">
        <label class="label mb-1">Lista de tareas</label>
        <select
          class="input"
          data-create-task-modal-target="todoSelect"
          required
        >
          <option value="">— Selecciona una lista —</option>
        </select>
      </div>
      <div class="mb-4" data-create-task-modal-target="dueDateField" hidden>
        <label class="label mb-1">Fecha de vencimiento</label>
        <input
          type="date"
          class="input"
          data-create-task-modal-target="dueDateInput"
        >
      </div>
      <div class="mb-6">
        <button
          type="button"
          class="flex items-center gap-1 text-sm font-bold text-ink/60 hover:text-brand transition-colors mb-2"
          data-action="click->create-task-modal#toggleNotes"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-create-task-modal-target="notesToggleIcon">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Agregar notas <span class="text-ink/40 font-normal">(opcional)</span>
        </button>
        <div class="hidden" data-create-task-modal-target="notesField">
          <textarea
            class="textarea resize-none"
            data-create-task-modal-target="taskNotes"
            placeholder="Notas adicionales sobre la tarea..."
            rows="3"
          ></textarea>
        </div>
      </div>
      <input type="hidden" data-create-task-modal-target="templateId" value="">
      <div class="flex justify-end gap-3">
        <button
          type="button"
          class="button-outline"
          data-action="click->create-task-modal#closeModal"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="button"
        >
          Crear tarea
        </button>
      </div>
    </form>
  </div>
</div>
