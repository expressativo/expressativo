<div class="card px-6 pt-6 pb-8 mb-4 max-w-2xl mx-auto">
  <h1 class="text-2xl font-display font-bold mb-6 text-ink">
    Agregar persona a <%= @project.title %>
  </h1>

  <%= form_with url: project_members_path(@project), method: :post, local: true do |form| %>
    <div class="mb-4">
      <%= form.label :email, "Email del usuario", class: "label" %>
      <%= form.email_field :email,
          class: "input",
          placeholder: "correo@ejemplo.com",
          required: true,
          autocomplete: "email" %>
      <p class="text-sm text-ink/60 mt-1">
        Ingresa el email de un usuario registrado en Tivo
      </p>
    </div>

    <div class="mb-6">
      <label class="label mb-2">Rol</label>
      <div class="space-y-3">
        <label class="flex items-start gap-3 p-3 rounded-xl border-2 border-ink cursor-pointer has-[:checked]:bg-brand-light transition-colors">
          <input type="radio" name="role" value="member" checked class="mt-0.5 accent-brand">
          <div>
            <div class="text-sm font-bold text-ink">Miembro</div>
            <div class="text-xs text-ink/50 mt-0.5">Acceso completo al proyecto: tareas, tableros, documentos, anuncios, chat.</div>
          </div>
        </label>
        <label class="flex items-start gap-3 p-3 rounded-xl border-2 border-ink cursor-pointer has-[:checked]:bg-warning/40 transition-colors">
          <input type="radio" name="role" value="viewer" class="mt-0.5 accent-warning">
          <div>
            <div class="text-sm font-bold text-ink">Observador</div>
            <div class="text-xs text-ink/50 mt-0.5">Solo puede ver las tareas que tiene asignadas y dejar comentarios en ellas.</div>
          </div>
        </label>
      </div>
    </div>

    <div class="flex gap-2">
      <%= form.submit "Agregar",
          class: "button",
          data: { turbo_submits_with: "Agregando..." } %>
      <%= link_to "Cancelar", project_members_path(@project), class: "button-outline" %>
    </div>
  <% end %>
</div>
