<%
  is_viewer = project_viewer?
  boards = @project.boards.includes(:columns)
  current_column = task.column
  current_board = current_column&.board
  status_styles = {
    "pending" => { active: "bg-paper text-ink", dot: "bg-ink/40" },
    "in_progress" => { active: "bg-info-light text-info", dot: "bg-info" },
    "done" => { active: "bg-success-light text-success", dot: "bg-success" }
  }
%>

<section class="bg-surface border-2 border-ink rounded-xl p-6 shadow-brutal">
  <h3 class="label mb-4">Detalles</h3>

  <div class="space-y-5">
    <%# Estado (pending / in_progress / done). Es independiente de la columna del tablero. %>
    <div>
      <div class="text-xs text-ink/50 mb-2">Estado</div>
      <% if is_viewer %>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border-2 border-ink text-sm font-semibold <%= status_styles.dig(task.status, :active) %>">
          <span class="w-2 h-2 rounded-full <%= status_styles.dig(task.status, :dot) %>"></span>
          <%= task_status_label(task.status) %>
        </span>
      <% else %>
        <%= form_with model: [@project, @todo, task], class: "grid grid-cols-3 gap-1.5" do |form| %>
          <%= hidden_field_tag :from, "show" %>
          <% Task::STATUSES.each do |status| %>
            <% active = task.status == status %>
            <button type="submit"
                    name="task[status]"
                    value="<%= status %>"
                    aria-pressed="<%= active %>"
                    <%= "disabled" if active %>
                    class="inline-flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-lg border-2 text-xs font-semibold transition-colors <%= active ? "border-ink #{status_styles.dig(status, :active)} cursor-default" : 'border-ink/20 text-ink/60 hover:border-ink hover:text-ink cursor-pointer' %>">
              <span class="w-2 h-2 rounded-full flex-shrink-0 <%= status_styles.dig(status, :dot) %>"></span>
              <span class="truncate"><%= task_status_label(status) %></span>
            </button>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Columna del tablero %>
    <% if boards.any? %>
      <div>
        <div class="text-xs text-ink/50 mb-2">Columna del tablero</div>
        <% if is_viewer %>
          <span class="text-sm text-ink/80">
            <%= current_column ? "#{current_column.title} · #{current_board.title}" : "Sin columna" %>
          </span>
        <% else %>
          <%= form_with model: [@project, @todo, task], class: "block" do |form| %>
            <%= hidden_field_tag :from, "show" %>
            <div data-controller="task-status">
              <div class="relative">
                <button
                  type="button"
                  data-action="click->task-status#toggleDropdown"
                  data-task-status-target="button"
                  aria-haspopup="listbox"
                  class="w-full flex items-center justify-between gap-2 px-3 py-2 text-sm rounded-lg border-2 border-ink bg-paper hover:opacity-90 focus:outline-none transition-colors">
                  <span class="inline-flex items-center gap-2 min-w-0">
                    <span class="font-medium <%= current_column ? 'text-ink' : 'text-ink/50' %> truncate" data-task-status-target="selectedText">
                      <%= current_column&.title || "Sin columna" %>
                    </span>
                    <% if current_board.present? %>
                      <span class="text-xs text-ink/40 truncate">· <%= current_board.title %></span>
                    <% end %>
                  </span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-ink/50 flex-shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M6 9l6 6l6 -6" />
                  </svg>
                </button>

                <div
                  data-task-status-target="dropdown"
                  class="dropdown-menu hidden absolute z-50 w-full mt-1 max-h-72 overflow-auto">
                  <% boards.each do |board| %>
                    <div class="p-2 border-b border-ink/10 last:border-b-0">
                      <div class="text-[10px] font-semibold text-ink/50 uppercase tracking-wider px-2 py-1">
                        <%= board.title %>
                      </div>
                      <% board.columns.each do |column| %>
                        <button
                          type="button"
                          data-action="click->task-status#selectColumn"
                          data-column-id="<%= column.id %>"
                          data-column-title="<%= column.title %>"
                          data-board-title="<%= board.title %>"
                          class="w-full text-left px-3 py-2 hover:bg-brand-light rounded text-sm <%= 'bg-brand-light font-medium text-brand-dark' if current_column&.id == column.id %>">
                          <%= column.title %>
                          <% if current_column&.id == column.id %>
                            <span class="text-xs text-brand ml-1">✓</span>
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>

                  <% if current_column.present? %>
                    <div class="p-2 border-t border-ink">
                      <button
                        type="button"
                        data-action="click->task-status#clearStatus"
                        class="w-full text-left px-3 py-2 text-danger hover:bg-danger-light rounded text-sm flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" aria-hidden="true">
                          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                          <path d="M18 6l-12 12" />
                          <path d="M6 6l12 12" />
                        </svg>
                        Quitar del tablero
                      </button>
                    </div>
                  <% end %>
                </div>

                <%= form.hidden_field :column_id, data: { task_status_target: "columnInput" } %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Fecha de vencimiento %>
    <div>
      <div class="text-xs text-ink/50 mb-2">Vence el</div>
      <% unless is_viewer %>
        <%= form_with model: [@project, @todo, task],
                      data: { controller: "auto-submit", auto_submit_delay_value: 1200, action: "change->auto-submit#submit" },
                      class: "mb-2" do |form| %>
          <%= hidden_field_tag :from, "show" %>
          <%= form.datetime_local_field :due_date, class: "input py-1", "aria-label": "Fecha de vencimiento" %>
        <% end %>
      <% end %>
      <% if task.due_date.present? %>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-sm font-medium <%= task_due_pill_classes(task) %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <%= task_due_label(task) %>
          </span>

          <%= link_to task_google_calendar_url(task, project_todo_task_url(@project, @todo, task)),
                target: "_blank", rel: "noopener",
                title: "Agregar a Google Calendar",
                class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-info bg-info-light border-2 border-ink rounded-lg hover:bg-info-light/70 transition-colors" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z M12 13v4m-2-2h4" />
            </svg>
            Google Calendar
          <% end %>

          <%= link_to calendar_project_todo_task_path(@project, @todo, task),
                title: "Descargar .ics para cualquier calendario",
                class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-ink/70 bg-paper border-2 border-ink rounded-lg hover:bg-accent/40 transition-colors" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            .ics
          <% end %>
        </div>
      <% elsif is_viewer %>
        <span class="text-sm text-ink/40 italic">Sin fecha</span>
      <% end %>
    </div>

    <%# Campos personalizados %>
    <% project_custom_fields = @project.custom_fields %>
    <% if project_custom_fields.any? %>
      <% task_cfv_map = task.custom_field_values.index_by(&:project_custom_field_id) %>
      <div class="pt-1">
        <div class="text-xs font-semibold text-ink/50 uppercase tracking-wider mb-3">Campos personalizados</div>
        <div class="space-y-3">
          <% project_custom_fields.each do |field| %>
            <%
              value_record = task_cfv_map[field.id]
              current_value = value_record&.value.to_s
              value_id = value_record&.id || 0
            %>
            <div>
              <div class="text-xs text-ink/50 mb-1"><%= field.name %></div>
              <%# Render de solo lectura para link y map %>
              <% if field.field_type == "link" && current_value.present? %>
                <%= link_to current_value, current_value, target: "_blank", rel: "noopener",
                      class: "inline-flex items-center gap-1 text-sm text-brand hover:text-brand-dark underline underline-offset-2 truncate max-w-full" do %>
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  <%= current_value.sub(%r{^https?://}, "").truncate(40) %>
                <% end %>
              <% elsif field.field_type == "map" && current_value.present? %>
                <% embed_url = ProjectCustomField.maps_embed_url(current_value) %>
                <% if embed_url %>
                  <div class="rounded-xl overflow-hidden border border-ink">
                    <iframe src="<%= embed_url %>"
                            width="100%"
                            height="200"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                  </div>
                <% end %>
                <%= link_to current_value, target: "_blank", rel: "noopener",
                      class: "inline-flex items-center gap-1.5 #{ embed_url ? 'mt-1 text-xs text-ink/50 hover:text-ink' : 'button w-full justify-center' }" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  Abrir en Google Maps
                <% end %>
              <% elsif is_viewer %>
                <span class="text-sm text-ink/80"><%= current_value.presence || "—" %></span>
              <% end %>
              <% unless is_viewer %>
                <%= form_with url: project_todo_task_custom_field_value_path(@project, @todo, task, value_id),
                              method: :patch,
                              data: { controller: "auto-submit", auto_submit_delay_value: 600, action: "change->auto-submit#submit" },
                              class: "flex items-center gap-1.5 #{"mt-1" if %w[link map].include?(field.field_type) && current_value.present?}" do |f| %>
                  <input type="hidden" name="project_custom_field_id" value="<%= field.id %>" />
                  <% case field.field_type %>
                  <% when "text" %>
                    <input type="text"
                           name="task_custom_field_value[value]"
                           value="<%= current_value %>"
                           placeholder="—"
                           aria-label="<%= field.name %>"
                           class="input flex-1 min-w-0 py-1" />
                  <% when "number" %>
                    <input type="number"
                           name="task_custom_field_value[value]"
                           value="<%= current_value %>"
                           placeholder="—"
                           aria-label="<%= field.name %>"
                           class="input flex-1 min-w-0 py-1" />
                  <% when "date" %>
                    <input type="date"
                           name="task_custom_field_value[value]"
                           value="<%= current_value %>"
                           aria-label="<%= field.name %>"
                           class="input flex-1 min-w-0 py-1" />
                  <% when "select" %>
                    <select name="task_custom_field_value[value]"
                            aria-label="<%= field.name %>"
                            class="input flex-1 min-w-0 py-1">
                      <option value="">— Sin valor —</option>
                      <% field.options_list.each do |opt| %>
                        <option value="<%= opt %>" <%= "selected" if current_value == opt %>><%= opt %></option>
                      <% end %>
                    </select>
                  <% when "link" %>
                    <input type="url"
                           name="task_custom_field_value[value]"
                           value="<%= current_value %>"
                           placeholder="https://"
                           aria-label="<%= field.name %>"
                           class="input flex-1 min-w-0 py-1" />
                  <% when "map" %>
                    <input type="text"
                           name="task_custom_field_value[value]"
                           value="<%= current_value %>"
                           placeholder='Pega el iframe de Google Maps o una URL'
                           aria-label="<%= field.name %>"
                           class="input flex-1 min-w-0 py-1" />
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Responsables %>
    <div>
      <div class="text-xs text-ink/50 mb-2">Responsables</div>
      <%= render 'tasks/assignees', task: task %>
    </div>

    <%# Documentos enlazados %>
    <div>
      <div class="text-xs text-ink/50 mb-2">Documentos</div>
      <%= render 'tasks/documents', task: task %>
    </div>

    <%# Reporter %>
    <div>
      <div class="text-xs text-ink/50 mb-2">Reportado por</div>
      <div class="flex items-center gap-2">
        <% if task.created_by.present? %>
          <%= user_avatar(task.created_by, class: "w-7 h-7 rounded-full object-cover") %>
          <span class="text-sm text-ink/80 truncate">
            <%= task.created_by.full_name.presence || task.created_by.email %>
          </span>
        <% else %>
          <span class="text-sm text-ink/40 italic">Sin usuario</span>
        <% end %>
      </div>
    </div>

    <div class="pt-4 border-t border-ink/10 space-y-1.5">
      <div class="flex items-center justify-between text-xs text-ink/50">
        <span>Creada</span>
        <span><%= l(task.created_at.to_date, format: :long) %></span>
      </div>
      <div class="flex items-center justify-between text-xs text-ink/50">
        <span>Actualizada</span>
        <span>hace <%= time_ago_in_words(task.updated_at) %></span>
      </div>
    </div>
  </div>
</section>
