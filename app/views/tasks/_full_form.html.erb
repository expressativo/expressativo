<section class="bg-surface border-2 border-ink rounded-xl p-6">
  <%# Guardar recarga toda la página (_top) para que el sidebar refleje los cambios. %>
  <%= form_with model: [@project, @todo, @task], data: { turbo_frame: "_top" } do |form| %>
    <%= hidden_field_tag :from, "full_form" %>
    <% if @task.errors.any? %>
      <div class="mb-4 rounded-lg border-2 border-danger/40 bg-danger-light px-3 py-2 text-sm text-danger">
        <%= @task.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-ink/10">
      <div class="flex items-center gap-2 text-xs text-ink/50 font-mono">
        <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
        <span class="text-ink/40">TASK-<%= @task.id %></span>
        <span class="text-ink/30">·</span>
        <span class="text-ink/50 truncate max-w-[200px]">Editando</span>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Cancelar", project_todo_task_path(@project, @todo, @task),
                    class: "button-outline",
                    data: { turbo_frame: "#{dom_id(@task)}_show" } %>
        <%= form.submit "Guardar",
            class: "button text-sm px-3 py-1.5",
            data: { turbo_submits_with: "Guardando..." } %>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <label class="flex-shrink-0 cursor-pointer">
        <%= form.check_box :completed, class: "sr-only peer" %>
        <span class="inline-flex w-7 h-7 items-center justify-center rounded-md border-2 border-ink bg-white peer-checked:bg-success peer-checked:border-emerald-500 peer-checked:text-white transition-colors">
          <svg class="w-4 h-4 opacity-0 peer-checked:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
          </svg>
        </span>
      </label>
      <%= form.text_field :title,
            class: "flex-1 text-2xl md:text-3xl font-bold text-ink leading-tight bg-transparent border-0 border-b border-transparent focus:border-brand focus:ring-0 focus:outline-none px-0 py-1",
            placeholder: "Describe esta tarea" %>
    </div>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-ink/50 uppercase tracking-wider mb-2">Vence el <span class="font-normal normal-case text-ink/40">(hora opcional)</span></label>
        <%= form.datetime_local_field :due_date, class: "input" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-ink/50 uppercase tracking-wider mb-2">Estado</label>
        <%= render 'tasks/status_selector', form: form, task: @task %>
      </div>
    </div>
    <div class="mt-6">
      <label class="block text-xs font-semibold text-ink/50 uppercase tracking-wider mb-2">Descripción</label>
      <%= form.rich_text_area :notes, placeholder: "Escribe la descripción de tu tarea aquí" %>
    </div>
  <div class="flex gap-2 mt-4">
    <%= form.submit "Guardar", class: "button", data: {
      turbo_submits_with: "Guardando..."
    }%>
    <%= link_to "Cancelar", project_todo_task_path(@project, @todo, @task), 
                class: "button-outline",
                data: { turbo_frame: "#{dom_id(@task)}_show" } %>
  </div>
<% end %>
