<div
  data-controller="task-document"
  data-task-document-search-url-value="<%= search_project_todo_task_task_documents_path(@project, @todo, task) %>"
  data-task-document-link-url-value="<%= project_todo_task_task_documents_path(@project, @todo, task) %>"
  data-task-document-unlink-base-url-value="<%= project_todo_task_task_documents_path(@project, @todo, task) %>"
  class="space-y-3"
>
  <!-- Lista de documentos enlazados -->
  <div data-task-document-target="linkedList" class="space-y-2">
    <% task.documents.each do |doc| %>
      <div class="flex items-center justify-between gap-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg" data-document-id="<%= doc.id %>">
        <%= link_to doc, class: "flex items-center gap-2 min-w-0 text-sm text-gray-800 hover:text-purple-600 truncate" do %>
          <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="truncate"><%= doc.name %></span>
        <% end %>

        <%= link_to project_todo_task_task_document_path(@project, @todo, task, doc.id),
                  method: :delete,
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "¿Desenlazar este documento de la tarea?"
                  },
                  class: "flex-shrink-0 text-red-600 hover:text-red-800" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Buscador de documentos -->
  <div class="relative">
    <div class="relative">
      <input
        type="text"
        data-task-document-target="input"
        data-action="input->task-document#search blur->task-document#hideResults"
        placeholder="Buscar documentos del proyecto..."
        class="input"
      />
      <svg class="absolute right-3 top-3 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <% if task.documents.empty? %>
      <span data-task-document-target="emptyState" class="text-xs text-gray-500 italic">
        No hay documentos enlazados a esta tarea
      </span>
    <% end %>

    <!-- Resultados de búsqueda -->
    <div
      data-task-document-target="results"
      class="hidden absolute top-12 z-100 w-full bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto"
    >
      <!-- Los resultados se insertan aquí dinámicamente -->
    </div>
  </div>
</div>
