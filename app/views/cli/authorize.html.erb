<div class="max-w-md mx-auto my-16 px-4">
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
    <div class="bg-gradient-to-br from-violet-600 to-indigo-600 px-6 py-8 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white/15 rounded-2xl mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-4.243 4.243L5.464 13.5" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-white">Autorizar <%= client_label %></h1>
      <p class="text-violet-100 text-sm mt-1">Conectá tu cuenta de Tivo</p>
    </div>

    <div class="p-6">
      <div class="bg-gray-50 rounded-lg p-4 mb-5 text-sm">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-violet-100 flex items-center justify-center text-violet-700 font-semibold">
              <%= current_user.initials %>
            </div>
          </div>
          <div class="min-w-0">
            <p class="font-medium text-gray-900 truncate">
              <%= current_user.full_name.presence || current_user.email %>
            </p>
            <p class="text-gray-500 text-xs truncate"><%= current_user.email %></p>
          </div>
        </div>
      </div>

      <p class="text-sm text-gray-600 mb-5">
        <strong class="text-gray-900"><%= client_label %></strong> está pidiendo acceso a tu cuenta para:
      </p>

      <ul class="space-y-2 text-sm text-gray-700 mb-6">
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Ver tus proyectos, listas y tareas</span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Crear y editar tareas</span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Marcar tareas como completadas</span>
        </li>
      </ul>

      <%= button_to "Autorizar acceso",
            cli_grant_path,
            method: :post,
            params: {
              client_id: @client_id,
              redirect_uri: @redirect_uri,
              state: @state,
              code_challenge: @code_challenge,
              code_challenge_method: @code_challenge_method
            },
            class: "w-full button justify-center",
            data: { turbo: false, turbo_submits_with: "Autorizando…" } %>

      <%= button_to "Cancelar",
            cli_deny_path,
            method: :post,
            class: "w-full button-outline justify-center mt-2",
            data: { turbo: false } %>

      <p class="text-xs text-gray-400 text-center mt-5">
        Si no reconocés esta solicitud, cerrá esta pestaña.
      </p>
    </div>
  </div>
</div>
