<%= render layout: 'projects/layout', locals: { project: @project, active: :boards } do %>
  <div class="mb-3">
    <%= link_to project_board_path(@project, @board), class: "inline-flex items-center gap-1.5 text-sm text-ink/70 hover:text-brand transition-colors" do %>
      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0" /><path d="M5 12l6 6" /><path d="M5 12l6 -6" /></svg>
      Volver al tablero
    <% end %>
  </div>

  <section class="bg-surface border-2 border-ink rounded-xl overflow-hidden" data-controller="bulk-task-selector">
    <header class="px-6 py-4 border-b-2 border-ink">
      <div class="min-w-0">
        <h2 class="text-lg font-semibold text-ink">Agregar tareas a <%= @board.title %></h2>
        <p class="text-sm text-ink/50">Selecciona tareas existentes o crea nuevas para agregarlas al tablero.</p>
      </div>
    </header>

    <div data-bulk-task-selector-target="actionButtons"
         class="hidden sticky top-0 z-10 bg-brand-light border-b-2 border-ink px-6 py-3">
      <div class="flex items-center justify-between gap-4">
        <span class="text-sm font-medium text-brand-dark">
          <span data-bulk-task-selector-target="selectedCount">0</span> tarea(s) seleccionada(s)
        </span>
        <button type="button"
                data-column-id="<%= @board.columns.order(position: :asc).first&.id %>"
                data-url="<%= attach_multiple_tasks_project_boards_path(@project) %>"
                data-action="click->bulk-task-selector#attachToColumn"
                class="button text-sm px-3 py-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Agregar al tablero
        </button>
      </div>
    </div>

    <% if @todos.any? %>
      <div class="p-6 space-y-4">
        <% @todos.each do |todo| %>
          <%= turbo_frame_tag "add_tasks_group_#{todo.id}" do %>
            <article class="bg-surface border-2 border-ink hover:bg-accent/10 rounded-xl p-4 transition" data-todo-group="<%= todo.id %>">
              <% available_tasks = todo.tasks.where(column_id: nil).not_done.list_ordered %>
              <% available_count = available_tasks.count %>

              <header class="flex items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                  <span class="status-dot"></span>
                  <h3 class="text-sm font-semibold text-ink truncate"><%= todo.name %></h3>
                </div>
                <span class="text-xs font-medium text-ink/70 bg-accent/30 rounded-full px-2 py-0.5 flex-shrink-0">
                  <%= available_count %> <%= available_count == 1 ? 'disponible' : 'disponibles' %>
                </span>
              </header>

              <% if available_tasks.any? %>
                <label class="flex items-center gap-2 mb-2 pb-2 border-b-2 border-ink/10 cursor-pointer">
                  <input type="checkbox"
                         data-action="change->bulk-task-selector#toggleAll"
                         class="w-4 h-4 text-brand focus:ring-0 border-ink rounded">
                  <span class="text-xs font-medium text-ink/50">Seleccionar todas</span>
                </label>

                <ul class="space-y-1">
                  <% available_tasks.each do |task| %>
                    <li class="flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-accent/20 transition group/task">
                      <input type="checkbox"
                             id="task_check_<%= task.id %>"
                             value="<%= task.id %>"
                             data-bulk-task-selector-target="checkbox"
                             data-action="change->bulk-task-selector#toggleTask"
                             class="w-4 h-4 text-brand focus:ring-0 border-ink rounded cursor-pointer">
                      <label for="task_check_<%= task.id %>" class="flex-1 min-w-0 text-sm text-ink/80 cursor-pointer truncate">
                        <%= task.title %>
                      </label>
                      <div class="flex items-center gap-2 flex-shrink-0 text-xs text-ink/40">
                        <% if task.due_date.present? %>
                          <span class="inline-flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <%= l(task.due_date, format: :short) %>
                          </span>
                        <% end %>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-xs text-ink/40 italic py-2">No hay tareas disponibles para agregar.</p>
              <% end %>

              <footer class="mt-3 pt-3 border-t-2 border-ink/10" data-controller="inline-task-form">
                <button type="button"
                        data-action="click->inline-task-form#show"
                        data-inline-task-form-target="trigger"
                        class="inline-flex items-center gap-1 text-sm font-medium text-ink/50 hover:text-brand transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  Agregar tarea
                </button>
                <%= form_with url: project_todo_tasks_path(@project, todo),
                              scope: :task,
                              method: :post,
                              data: { turbo_frame: "add_tasks_group_#{todo.id}", inline_task_form_target: "form" },
                              class: "hidden flex items-center gap-2" do |f| %>
                  <%= hidden_field_tag :from, 'add_tasks' %>
                  <%= hidden_field_tag :board_id, @board.id %>
                  <%= f.text_field :title,
                        placeholder: "Describe la tarea",
                        required: true,
                        data: { inline_task_form_target: "input" },
                        class: "flex-1 min-w-0 text-sm bg-transparent border-0 border-b-2 border-ink focus:border-brand focus:ring-0 focus:outline-none px-1 py-1 placeholder:text-ink/40" %>
                  <%= f.submit "Guardar",
                        class: "button text-xs px-2.5 py-1" %>
                  <button type="button"
                          data-action="click->inline-task-form#hide"
                          class="inline-flex items-center justify-center w-7 h-7 text-ink/40 hover:text-ink/70 rounded-md hover:bg-accent/40 transition"
                          aria-label="Cancelar">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                <% end %>
              </footer>
            </article>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-16 text-center">
        <div class="w-20 h-20 mx-auto mb-5 rounded-2xl bg-brand-light flex items-center justify-center text-brand">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-ink mb-1">No hay listas de tareas</h3>
        <p class="text-sm text-ink/50 mb-5 max-w-sm mx-auto">
          Crea una lista de tareas primero para poder agregar tareas al tablero.
        </p>
        <%= link_to project_todos_path(@project),
              class: "button" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Ir a listas de tareas
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
