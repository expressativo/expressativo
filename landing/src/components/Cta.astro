---

import { register_url } from "./constants.js"

---

<section id="get-started" class="relative overflow-hidden border-b-2 border-ink bg-brand-light">
  <div
    class="absolute -bottom-16 -right-10 w-64 h-64 rounded-full bg-accent border-2 border-ink hidden lg:block"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-20 md:py-24 text-center">
    <h2 class="text-3xl sm:text-4xl md:text-5xl">Ready to run projects without the chaos?</h2>
    <p class="mt-5 text-lg text-ink/70 max-w-xl mx-auto">
      Spin up Tivo, invite your team, and move your first task across the
      board in under five minutes.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a href={register_url} class="btn-brutal !text-base !px-8 !py-4" target="_blank">
        Create your first project
      </a>
      <a href="#pricing" class="btn-brutal-outline !text-base !px-8 !py-4">
        See pricing
      </a>
    </div>
  </div>
</section>
