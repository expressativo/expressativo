---

import { register_url } from "./constants.js"

---

<section id="top" class="relative overflow-hidden border-b-2 border-ink">
  <!-- decorative shapes -->
  <div
    class="absolute -top-10 -right-16 w-72 h-72 rounded-full bg-accent border-2 border-ink hidden lg:block"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-40 -left-24 w-64 h-64 rotate-12 bg-accent-pink/70 border-2 border-ink hidden lg:block"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <span class="chip bg-accent">
          <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>
          Now with real-time chat
        </span>

        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl leading-[1.05]">
          Project management that
          <span class="relative inline-block whitespace-nowrap">
            <span class="relative z-10">doesn't get in your way</span>
            <span
              class="absolute left-0 right-0 bottom-1 h-4 bg-brand-light -z-0 -rotate-1"
              aria-hidden="true"
            ></span>
          </span>
        </h1>

        <p class="mt-6 text-lg text-ink/70 max-w-xl">
          Tivo bundles kanban boards, team chat, documents, and announcements
          into one bold, no-nonsense workspace &mdash; so your team stops
          juggling five different apps to ship one project.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={register_url} class="btn-brutal !text-base !px-7 !py-3.5" target="_blank">
            Get Tivo, it's free
          </a>
          <a href="#workflow" class="btn-brutal-outline !text-base !px-7 !py-3.5">
            See how it works
          </a>
        </div>

        <p class="mt-5 text-sm font-semibold text-ink/50">
          Free for 1 project &middot; No credit card required &middot; Plans from $20/mo
        </p>
      </div>

      <!-- Kanban mockup card -->
      <div class="relative">
        <div class="card-brutal p-4 sm:p-5 rotate-1">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-danger border border-ink"></span>
              <span class="w-3 h-3 rounded-full bg-accent border border-ink"></span>
              <span class="w-3 h-3 rounded-full bg-success border border-ink"></span>
            </div>
            <span class="chip !py-0.5 !text-[10px] bg-brand-light">Launch Week</span>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="space-y-2">
              <p class="font-display text-xs font-bold uppercase text-ink/50">Pending</p>
              <div class="card-brutal shadow-brutal-sm p-2.5 bg-paper">
                <p class="text-xs font-semibold">Write launch copy</p>
              </div>
              <div class="card-brutal shadow-brutal-sm p-2.5 bg-paper">
                <p class="text-xs font-semibold">Review pricing</p>
              </div>
            </div>
            <div class="space-y-2">
              <p class="font-display text-xs font-bold uppercase text-ink/50">In progress</p>
              <div class="card-brutal shadow-brutal-sm p-2.5 bg-brand-light">
                <p class="text-xs font-semibold">Kanban drag &amp; drop</p>
                <div class="mt-2 h-1.5 rounded-full bg-ink/10 overflow-hidden">
                  <div class="h-full w-2/3 bg-brand"></div>
                </div>
              </div>
            </div>
            <div class="space-y-2">
              <p class="font-display text-xs font-bold uppercase text-ink/50">Done</p>
              <div class="card-brutal shadow-brutal-sm p-2.5 bg-success-light">
                <p class="text-xs font-semibold line-through text-ink/50">Set up chat</p>
              </div>
            </div>
          </div>
        </div>

        <div
          class="absolute -bottom-6 -left-6 card-brutal shadow-brutal px-4 py-3 bg-accent rotate-[-4deg] hidden sm:block"
        >
          <p class="font-display font-extrabold text-sm">+12 tasks shipped</p>
        </div>
      </div>
    </div>
  </div>
</section>
