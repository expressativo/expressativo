---
---

<section id="workflow" class="border-b-2 border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      <span class="chip bg-accent-pink/40">From chat to shipped</span>
      <h2 class="mt-4 text-3xl sm:text-4xl">Talk it through, write it down, get it done</h2>
      <p class="mt-4 text-lg text-ink/70">
        A quick message turns into a documented decision, and a documented
        decision turns into a tracked task — all without leaving the project.
      </p>
    </div>

    <div class="mt-14 grid lg:grid-cols-2 gap-8 items-stretch">
      <!-- chat mockup -->
      <div class="card-brutal p-5 bg-surface">
        <div class="flex items-center gap-2 pb-3 border-b-2 border-ink mb-4">
          <span class="w-8 h-8 rounded-lg bg-brand border-2 border-ink"></span>
          <div>
            <p class="font-display font-bold text-sm leading-tight">#launch-week</p>
            <p class="text-xs text-ink/50">4 members</p>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex gap-2.5">
            <span class="w-7 h-7 rounded-full bg-accent border-2 border-ink shrink-0"></span>
            <div class="bg-paper border-2 border-ink rounded-xl rounded-tl-none px-3 py-2 text-sm">
              can we move the pricing page task to <span class="font-bold text-brand">@mia</span>?
            </div>
          </div>
          <div class="flex gap-2.5 flex-row-reverse">
            <span class="w-7 h-7 rounded-full bg-brand-light border-2 border-ink shrink-0"></span>
            <div class="bg-brand text-white border-2 border-ink rounded-xl rounded-tr-none px-3 py-2 text-sm">
              done — moved &amp; commented on the task
            </div>
          </div>
          <div class="flex items-center gap-1.5 pl-9">
            <span class="chip !py-0.5 !text-[10px] bg-accent">+1</span>
            <span class="chip !py-0.5 !text-[10px] bg-success-light">nice</span>
          </div>
        </div>
      </div>

      <!-- document mockup -->
      <div class="card-brutal p-5 bg-surface flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b-2 border-ink mb-4">
          <p class="font-display font-bold text-sm">Launch Checklist.doc</p>
          <span class="chip !py-0.5 !text-[10px] bg-success-light">Published</span>
        </div>
        <div class="space-y-2.5 text-sm flex-1">
          <p class="font-display font-bold">Pre-launch</p>
          <label class="flex items-center gap-2 text-ink/70">
            <span class="w-4 h-4 rounded border-2 border-ink bg-success grid place-items-center text-white text-[10px] font-bold">
              &#10003;
            </span>
            Finalize pricing page copy
          </label>
          <label class="flex items-center gap-2 text-ink/70">
            <span class="w-4 h-4 rounded border-2 border-ink bg-success grid place-items-center text-white text-[10px] font-bold">
              &#10003;
            </span>
            Set up team chat channels
          </label>
          <label class="flex items-center gap-2">
            <span class="w-4 h-4 rounded border-2 border-ink"></span>
            Announce to the whole project
          </label>
        </div>
        <div class="mt-4 pt-3 border-t-2 border-ink flex items-center gap-2 text-xs text-ink/50">
          <span class="w-5 h-5 rounded-full bg-accent-pink/50 border-2 border-ink"></span>
          Edited 2 minutes ago
        </div>
      </div>
    </div>
  </div>
</section>
